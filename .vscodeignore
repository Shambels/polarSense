# Everything the extension needs at runtime is bundled into dist/extension.js
# plus the two wasm files in assets/. Everything else is development-only.
#
# The rule to remember: .vscodeignore is a *denylist*, so anything new in the
# repo ships by default. A 249 MB .venv reached a package this way once.

# --- source and build tooling ---
src/**
test/**
scripts/**
out/**
node_modules/**
*.ts
tsconfig.json
esbuild*.mjs
**/*.map
assets/demo.gif

# --- editor and CI config ---
.vscode/**
.vscode-test/**
.github/**

# --- the Python side: fixtures are generated locally, never shipped ---
.venv
.venv/**
**/.venv/**
pyproject.toml
uv.lock
**/__pycache__/**
*.pyc

# --- repository and build artefacts ---
.gitignore
.gitattributes
**/.DS_Store
*.vsix
*.tgz
_to_delete/**
coverage/**
*.log

# --- developer documentation ---
# README.md is the GitHub one and is deliberately excluded: the Marketplace
# listing is built from README.marketplace.md, which vsce force-includes via
# --readme-path and renames to README.md inside the VSIX. Shipping both would
# put two readmes in the package. CHANGELOG.md is the Marketplace's Changelog
# tab and stays.
docs/**
RELEASING.md
README.md
CLAUDE.md
